EUREKA_ADMIN_PASSWORD=eureka
# Secreto de sesión de clientes (login real). Pon un valor largo y aleatorio en producción.
EUREKA_AUTH_SECRET=cambia-esto-por-un-secreto-largo
# Secreto de sincronización con FacturaScripts (lo envía n8n en la cabecera X-Sync-Secret).
EUREKA_SYNC_SECRET=cambia-esto-por-otro-secreto-largo
# Solo si migras a PostgreSQL (Prisma):
DATABASE_URL="postgresql://user:pass@localhost:5432/eureka?schema=public"
# Emails (boletín): datos SMTP del correo de la tienda.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 y una "contraseña de aplicación" (no la normal).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="EUREKA <tu-correo@ejemplo.com>"
# Código que se envía al suscribirse (debe existir como código promocional en Stripe)
NEWSLETTER_CODE=BIENVENIDA20
# Dirección pública de la web para los enlaces de los emails
EUREKA_BASE_URL=https://eurekamoda.com
