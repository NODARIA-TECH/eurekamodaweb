# Contraseña del panel (/admin): al menos 10 caracteres, NUNCA "eureka"
EUREKA_ADMIN_PASSWORD=
# Secreto de sesión de clientes (login real). Pon un valor largo y aleatorio en producción.
EUREKA_AUTH_SECRET=   # openssl rand -hex 32
# Secreto de sincronización con FacturaScripts (lo envía n8n en la cabecera X-Sync-Secret).
EUREKA_SYNC_SECRET=   # openssl rand -hex 32 (el mismo en n8n)
# Solo si migras a PostgreSQL (Prisma):
DATABASE_URL="postgresql://user:pass@localhost:5432/eureka?schema=public"
# Emails (boletín): salen del buzón de la tienda en IONOS (hola@eurekamoda.com) a través de un Worker
# de Cloudflare (cloudflare/correo-worker.js), porque DigitalOcean bloquea los puertos de correo y no los desbloquea.
# La contraseña del buzón va en el Worker, no aquí.
MAIL_RELAY_URL=https://eureka-correo.<tu-subdominio>.workers.dev
MAIL_RELAY_TOKEN=
MAIL_FROM="EUREKA <hola@eurekamoda.com>"
# Opcional: a dónde llegan las respuestas de las clientas
MAIL_REPLY_TO=
NEWSLETTER_CODE=BIENVENIDA20
# Dirección pública de la web para los enlaces de los emails
EUREKA_BASE_URL=https://eurekamoda.com
# Pagos con Stripe
STRIPE_SECRET_KEY=
# Webhook: Stripe → Developers → Webhooks → Add endpoint → https://eurekamoda.com/api/stripe/webhook
# eventos checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.expired
STRIPE_WEBHOOK_SECRET=
# A quién avisar de cada pedido nuevo (si no, a MAIL_REPLY_TO o al correo del aviso legal)
SHOP_NOTIFY_EMAIL=
